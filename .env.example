# Supabase (Project Settings > API)
VITE_BASE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_BASE_SUPABASE_KEY=eyJ...

# i18n (opcional)
VITE_I18N_LOCALE=es
VITE_I18N_FALLBACK_LOCALE=en

# Solo para `pnpm data`: sube los datos generados a la tabla game_data.
# Es la cadena del "Session pooler" (Connect > Direct connection) con el rol
# `pogodex_pipeline`, que solo puede escribir los datos del juego (ver
# supabase/migrations/20260928_rls_datos_y_rol_pipeline.sql). Sin ella el
# script genera los ficheros igual, solo que no sube nada.
SUPABASE_DB_URL=postgresql://pogodex_pipeline.xxxx:[TU-PASSWORD]@aws-1-eu-west-1.pooler.supabase.com:5432/postgres
