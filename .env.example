# Supabase (Project Settings > API)
VITE_BASE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_BASE_SUPABASE_KEY=eyJ...

# i18n (opcional)
VITE_I18N_LOCALE=es
VITE_I18N_FALLBACK_LOCALE=en

# Solo para `pnpm data`: sube los datos generados a la tabla game_data.
# Es la cadena del "Session pooler" (Connect > Direct connection) con tu
# contrasena de base de datos. Sin ella el script genera los ficheros igual,
# solo que no sube nada.
SUPABASE_DB_URL=postgresql://postgres.xxxx:[TU-PASSWORD]@aws-1-eu-west-1.pooler.supabase.com:5432/postgres
