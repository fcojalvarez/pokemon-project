{
  "name": "pokemon-project",
  "version": "1.0.0",
  "packageManager": "pnpm@8.10.3",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "pnpm": {
    "overrides": {
      "minimatch@9": "^9.0.9"
    }
  },
  "scripts": {
    "dev": "vite",
    "dev-host": "vite --host",
    "build": "vite build",
    "preview": "vite preview",
    "test:unit": "vitest",
    "lint": "eslint . --ext .vue,.js,.jsx,.cjs,.mjs --fix --ignore-path .gitignore",
    "format": "prettier --write src/",
    "data": "node scripts/build-data.mjs",
    "data:fresh": "node scripts/build-data.mjs --fresh",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "icons": "node scripts/build-icons.mjs",
    "max": "node scripts/fetch-max-battles.mjs",
    "traducir": "node scripts/translate-live.mjs",
    "noticias": "node scripts/fetch-news.mjs",
    "sprites": "node scripts/build-sprites.mjs",
    "avisos": "node scripts/send-push.mjs"
  },
  "dependencies": {
    "@supabase/postgrest-js": "1.8.4",
    "@supabase/supabase-js": "^2.117.2",
    "pinia": "^2.1.6",
    "vue": "^3.5.43",
    "vue-i18n": "^9.14.5",
    "vue-router": "^4.2.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@rushstack/eslint-patch": "^1.4.0",
    "@vitejs/plugin-vue": "^5.2.4",
    "@vue/eslint-config-prettier": "^7.1.0",
    "@vue/test-utils": "^2.4.1",
    "autoprefixer": "^10.6.1",
    "eslint": "^8.49.0",
    "eslint-plugin-vue": "^9.17.0",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^30.1.1",
    "pg": "^8.23.0",
    "postcss": "^8.5.28",
    "prettier": "^2.8.8",
    "sharp": "^0.35.5",
    "tailwindcss": "^3.4.19",
    "vite": "^6.4.3",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^3.2.7",
    "web-push": "3.6.7",
    "workbox-window": "7.4.1"
  }
}
